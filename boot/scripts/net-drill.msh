# The network drill's script: sockets as values.
# The wire: the host's echo at 10.0.2.100:9000.
let s = (connect 10.0.2.100 9000)?
send $s "moss script tcp"
let got = (from-bytes (recv $s)?)?
if $got != "moss script tcp" { (err "wire echo mismatch: $got")? }
close $s
echo "script: wire echo ok"
# Loopback, all in one script: listen, connect, accept, send, receive.
let l = (listen 7778)?
let c = (connect ::1 7778)?
let a = (accept $l)?
send $c "over loopback"
match (from-bytes (recv $a)?) {
  ok "over loopback" => echo "script: loopback ok"
  ok $other => (err "loopback mismatch: $other")?
  err $e => (err "loopback: $e")?
}

# A socket handed to a worker: the worker serves the connection on its
# own net view (the socket crossed to it via a fabric-less handoff).
let wl = (listen 8090)?
let wc = (connect ::1 8090)?
let wa = (accept $wl)?
send $wc "over a worker"
let echoer = (spawn { let m = (from-bytes (recv $in)?)?; (send $in $m)?; "served" })?
let served = ($wa | call $echoer)?
if $served != "served" { (err "socket to worker: $served")? }
if (from-bytes (recv $wc)?)? != "over a worker" { (err "socket to worker echo failed")? }
close $wc
echo "script: socket to worker ok"
# Concurrent serve: two connections, each handed to its own worker with
# `dispatch` (async) so both serve at once, then reaped with `await`.
# (We cannot force true simultaneity in the drill; this proves each
# connection is served on its own worker and both come back correct.)
let cl = (listen 8092)?
let cc1 = (connect ::1 8092)?
let ca1 = (accept $cl)?
let cc2 = (connect ::1 8092)?
let ca2 = (accept $cl)?
send $cc1 "alpha"
send $cc2 "beta"
let cw1 = (spawn { let m = (from-bytes (recv $in)?)?; (send $in $m)?; "ok" })?
let cw2 = (spawn { let m = (from-bytes (recv $in)?)?; (send $in $m)?; "ok" })?
($ca1 | dispatch $cw1)?
($ca2 | dispatch $cw2)?
(await $cw1)?
(await $cw2)?
if (from-bytes (recv $cc1)?)? != "alpha" { (err "concurrent serve 1 wrong")? }
if (from-bytes (recv $cc2)?)? != "beta" { (err "concurrent serve 2 wrong")? }
close $cc1
close $cc2
echo "script: concurrent serve ok"
# Bulk: more than one segment in flight, both ways — the window at work.
def recv-all [s, want] {
  if $want <= 0 { ok (to-bytes "") } else {
    let b = (recv $s)?
    let rest = (recv-all $s ($want - ($b | len)))?
    ok ($b + $rest)
  }
}
let big = (range 0 500 | map { "0123456789" } | join "")
let w = (connect 10.0.2.100 9000)?
send $w $big
let back = (from-bytes (recv-all $w ($big | len))?)?
if $back != $big { (err "bulk wire echo mismatch")? }
close $w
echo "script: bulk wire echo ok"
send $c $big
let back2 = (from-bytes (recv-all $a ($big | len))?)?
if $back2 != $big { (err "bulk loopback mismatch")? }
echo "script: bulk loopback ok"
# HTTP. The client: a canned server on the host (guestfwd at :9001).
let r = (fetch http://10.0.2.100:9001/hello)?
if $r.status != 200 or $r.body != "hello moss!" { (err "fetch: $r.status $r.body")? }
echo "script: fetch ok"
# Again: the first answer said nothing about closing, so the connection
# was kept — and the canned server closed it anyway. fetch notices and
# retries once on a fresh one.
let r2 = (fetch http://10.0.2.100:9001/hello)?
if $r2.body != "hello moss!" { (err "fetch again: $r2.body")? }
echo "script: fetch again ok"
# The primitives over loopback: a raw request in, a parsed record out.
let hl = (listen 8081)?
let hc = (connect ::1 8081)?
send $hc "GET /raw?x=1 HTTP/1.1\r\nHost: moss\r\nContent-Length: 2\r\n\r\nhi"
let ha = (accept $hl)?
let req = (http-read $ha)?
if $req.method != "GET" or $req.path != "/raw" or $req.query != "x=1" or $req.body != "hi" or $req.headers.host != "moss" { (err "http-read: bad parse")? }
(http-write $ha { status: 201, body: { made: true } })?
close $ha
let raw = (from-bytes (recv $hc)?)?
if ($raw | split "\r\n" | first 1) != ["HTTP/1.1 201 Created"] { (err "http-write: bad status line")? }
if not ($raw | split "\r\n" | any { $it == "Content-Type: application/json" }) { (err "http-write: no json type")? }
echo "script: http primitives ok"
# The server: the host's runner fetches three pages through a port
# forward, then serve returns.
def handler [req] {
  match $req.path {
    "/hello" => "hello from moss"
    "/json" => [{ n: 1 }, { n: 2 }]
    "/echo" => { status: 200, headers: { x-method: $req.method }, body: $req.body }
    _ => { status: 404, body: "no such page" }
  }
}
let srv = (listen 8080)?
echo "script: serving http"
let n = (serve $srv $handler 7)?
echo "script: served $n"
# Datagrams over loopback, both families: a bound port hears what an
# ephemeral socket sends it, with the sender's address and port.
let d = (udp-bind 5353)?
let e = (udp-bind 0)?
(udp-send $e ::1 5353 "ping")?
match (udp-recv $d) {
  ok { from: "::1", port: $p, data: $b } => {
    if (from-bytes $b)? != "ping" { (err "udp: wrong data")? }
    (udp-send $d ::1 $p "pong")?
  }
  ok $other => (err "udp: unexpected datagram $other")?
  err $x => (err "udp: $x")?
}
let back = (udp-recv $e)?
if (from-bytes $back.data)? != "pong" or $back.port != 5353 { (err "udp: no pong")? }
(udp-send $e 10.0.2.15 5353 (to-bytes "four"))?
let v4 = (udp-recv $d)?
if $v4.from != "10.0.2.15" or ($v4.data | len) != 4 { (err "udp v4: $v4")? }
close $d
close $e
echo "script: udp loopback ok"
# Names: dnsd on this node serves moss.test, and the resolver asks it
# first; a name that is not there is an err by its word.
let www = (resolve www.moss.test)?
if $www != ["::1"] { (err "resolve www: $www")? }
let node1 = (resolve node1.moss.test)?
if ($node1 | len) != 2 { (err "resolve node1: $node1")? }
match (resolve nope.moss.test) {
  ok $a => (err "nope resolved: $a")?
  err nxdomain => echo "script: nxdomain ok"
  err $e => (err "resolve nope: $e")?
}
let nl = (listen 8084)?
let nc = (connect www.moss.test 8084)?
let na = (accept $nl)?
send $nc "by name"
if (from-bytes (recv $na)?)? != "by name" { (err "connect by name: wrong data")? }
close $nc
close $na
echo "script: resolve ok"
# The wall clock: the kernel read the RTC at boot, the time service
# refined it; date is a record with the calendar in it.
let d = (date)?
if $d.unix < 1700000000 or ($d.iso | len) != 20 { (err "date: $d")? }
let iso = $d.iso
echo "script: date $iso"
# TLS: the runner's openssl serves tls.moss.test (10.0.2.2 by our zone)
# with a certificate the drill's own root vouches for; fetch speaks https.
let t = (fetch https://tls.moss.test:31910/)?
if $t.status != 200 or ($t.body | split "TLSv1.3" | len) < 2 { (err "fetch https: $t.status")? }
echo "script: https ok"
# The address is not the name: the certificate is for tls.moss.test.
match (fetch https://10.0.2.2:31910/) {
  ok _ => (err "https by address was trusted")?
  err host_mismatch => echo "script: https mismatch refused"
  err $e => (err "https by address: $e")?
}
# The primitives: a connection as a value, bytes both ways.
let tc = (tls-connect tls.moss.test 31910)?
send $tc "GET / HTTP/1.0\r\n\r\n"
let page = (from-bytes (recv $tc)?)?
if ($page | split "\r\n" | first 1) != ["HTTP/1.0 200 ok"] { (err "tls recv: $page")? }
close $tc
echo "script: tls primitives ok"
# TLS the other way: this node serves https, and the runner (openssl
# s_client) fetches one page through a port forward, verifying the
# certificate against the drill's root.
let ts = (tls-listen 8443)?
echo "script: serving https"
# One connection by hand: accept, read the request over TLS, answer.
let tc = (accept $ts)?
let treq = (http-read $tc)?
if $treq.path != "/" { (err "tls http-read: $treq.path")? }
(http-write $tc { status: 200, body: "secure hello from moss" })?
close $tc
close $ts
echo "script: served https ok"
# A closed peer is an err, not a hang; a refused view is an err too.
close $c
match (recv $a) { ok _ => (err "data after close")?; err $e => echo "script: after close: $e" }
match (connect 10.0.2.2 9) { ok _ => (err "gateway port 9 answered")?; err $e => echo "script: gateway: $e" }
