# The fixture web server, plain HTTP: the pages under boot/web/, read
# through a read-only view of that directory, served on port 8080 over
# the unit's own network view. The page table is explicit — a request
# names a page or gets a 404 — so nothing about the view leaks past the
# pages that are meant to be served. Beside the pages: a redirect chain
# (/r1 → /r2 → /r3 → /about.html, one of each kind), a gzip body served
# as-is with its coding declared (/gz), and a large body streamed from
# a small file sent many times over (/big: index.html × 8192), and one
# larger than a page domain's arena (/boom: × 40000, 23.8 MB — under
# the broker's cap, over what a page can hold), and /submit, which
# answers a form with the method, query and body it received. Serves
# until the boot ends.
let pages = [
  { path: "/", file: "index.html" }
  { path: "/index.html", file: "index.html" }
  { path: "/about.html", file: "about.html" }
  { path: "/spoof.html", file: "spoof.html" }
  { path: "/form.html", file: "form.html" }
  { path: "/hello.txt.gz", file: "hello.txt.gz" }
  { path: "/images.html", file: "images.html" }
  { path: "/img/solid.png", file: "img/solid.png" }
  { path: "/img/grad.jpg", file: "img/grad.jpg" }
  { path: "/img/blue.gif", file: "img/blue.gif" }
  { path: "/img/prog.jpg", file: "img/prog.jpg" }
  { path: "/img/plexserif.woff", file: "img/plexserif.woff" }
  { path: "/linked.html", file: "linked.html" }
  { path: "/app.html", file: "app.html" }
  { path: "/app.js", file: "app.js" }
  { path: "/linked.css", file: "linked.css" }
  { path: "/css/imported.css", file: "css/imported.css" }
]
def page [req] {
  match $req.path {
    "/r1" => { status: 301, headers: { location: "/r2" }, body: "moved" }
    "/r2" => { status: 302, headers: { location: "r3" }, body: "found" }
    "/r3" => { status: 303, headers: { location: "/about.html" }, body: "see other" }
    "/gz" => { status: 200, headers: { content-encoding: gzip, content-type: "text/plain; charset=utf-8" }, body: { file: "hello.txt.gz" } }
    "/big" => { status: 200, body: { file: "index.html", repeat: 8192 } }
    "/notes.download" => { status: 200, headers: { content-type: "application/octet-stream" }, body: { file: "notes.txt" } }
    "/submit" => { status: 200, headers: { content-type: "text/html; charset=utf-8" }, body: ("<!DOCTYPE html><title>moss fixture: submitted</title><h1>Submitted</h1><p>method " + $req.method + "</p><p>query " + $req.query + "</p><p>body " + $req.body + "</p>") }
    "/boom" => { status: 200, body: { file: "index.html", repeat: 40000 } }
    _ => (match ($pages | find (fn [p] { $p.path == $req.path })) {
        nothing => { status: 404, body: "no such page" }
        $hit => { status: 200, body: { file: $hit.file } }
      })
  }
}
let srv = (listen 8080)?
echo "webfix: serving http"
(http-serve $srv $page)?
