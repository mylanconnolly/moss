# A movable demo window (the desktop drill, window B). It opens narrow,
# where the `at` places it, with a draggable traffic-light titlebar (the
# runtime draws it). Closing it (the red dot) ends the app.
#
# Open deliberately second: both windows are plain `desktop` units that
# init starts together, and the compositor stacks whoever calls
# createSurface last on top. The drill relies on Beta being the top window
# (it clicks Alpha to raise it), so wait a beat to let Alpha claim the
# lower z first — otherwise, when Beta wins the race, Alpha is already on
# top and the raising click is a silent no-op (a ~1-in-a-dozen flake).
sleep 500
let final = (gui {
    init:  { n: 0 }
    title: "Beta"
    width: 320
    at:    { x: 560, y: 240 }
    view: (fn [state] {
        {
          kind: "column"
          children: [
            { kind: "label", text: ("clicks: " + (str $state.n)) }
            { kind: "button", id: "tap", label: "tap me", variant: "primary" }
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "tap" => { { n: ($state.n + 1) } }
          _ => $state
        }
      })
  })
echo "win-beta: closed"
