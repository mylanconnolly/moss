# The desktop's top bar — the session's persistent chrome, and the owner of
# the session's appearance and locale. At login it applies the user's saved
# appearance (conf/font.msh) and locale (conf/locale.msh) from their home, so
# the whole desktop — this bar's own clock included — renders in them. Its
# system menu launches the settings app ("Settings…" → `launch "settings"`
# over the session's init front channel) and logs out. It is the session's
# ESSENTIAL unit: "Log Out" reverts to the system defaults and ends it, which
# tears the whole session (dock, any open windows) down.
#
# The clock and date read the SESSION locale (bare fmt-time/fmt-date, no tag),
# which localesvc holds — so changing the locale in settings changes the
# clock too, live, session-wide.

# Apply the user's saved appearance + locale for the session first.
match (cat "conf/font.msh") {
  ok $l => { sessionfont $l }
  _ => null
}
match (cat "conf/locale.msh") {
  ok $l => { sessionlocale ($l | from-data | get "locale") }
  _ => null
}

def clock-now [] {
  match (fmt-time) {
    ok $t => $t
    err _ => "--:--:--"
  }
}
def date-now [] {
  match (fmt-date) {
    ok $d => $d
    err _ => ""
  }
}

let final = (gui {
    init: { note: "" }
    bar:  true
    tick: 1000
    view: (fn [state] {
        {
          left: [
            { kind: "menu", id: "system", title: "moss", items: ["About This System", "Settings…", "Log Out"] }
            { kind: "label", muted: true, text: $state.note }
          ]
          right: [
            { kind: "label", muted: true, text: (date-now) }
            { kind: "label", text: (clock-now) }
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.item {
          "Log Out" => { { note: "logging out", done: true } }
          "Settings…" => {
            launch "settings"
            { note: "opened settings" }
          }
          _ => { { note: ("selected: " + $ev.item) } }
        }
      })
  })
# The session is ending: revert the shared appearance + locale to the system
# defaults so the next login starts clean, then exit (essential → teardown).
sessionfont
sessionlocale
echo ("topbar: exit note=" + (str $final.note))
