# The graphical session shell (the post-login GUI): a minimal desktop that
# runs as the logged-in user in their own session domain, rendered through
# the shared font service. It is a GUI service like any other — a pure
# view/update — with a single "log out" button; firing it returns a state
# with done:true, the runtime closes the window, mshrun exits, the session
# domain exits, and the manager tears the session down. The whole
# session's UI, defined in mshl.
#
# First, apply this user's font preference for the session: read their
# own font layer from the home (conf/font.msh, seeded on first login) and
# push it to the shared font service, which merges it over the system
# layer — so the whole session's type follows the user's accessibility
# scale. A home with no layer simply keeps the system default. This runs
# before the window opens, so the shell renders at the user's scale; the
# `sessionfont` at the end reverts it on logout.
match (cat "conf/font.msh") {
  ok $layer => { sessionfont $layer }
  _ => null
}
let final = (gui {
    init:  { done: false }
    title: "moss"
    view: (fn [state] {
        {
          kind: "column"
          children: [
            { kind: "label", text: "signed in to moss" }
            { kind: "button", id: "logout", label: "log out" }
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "logout" => { { done: true } }
          _ => $state
        }
      })
  })
sessionfont
"gui: shell exited"
