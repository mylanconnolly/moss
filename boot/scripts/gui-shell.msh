# The graphical session's settings app (the post-login GUI): a two-pane
# settings desktop that runs as the logged-in user in their own session
# domain, rendered through the shared font service.
#
#   YOU (the user pane): this user's own appearance (the accessibility text
#   scale, the theme, the high-contrast and colourblind-safe switches) and
#   their preferred locale (a live sample shows a date and a number in it).
#   "apply" persists both to the user's home (conf/font.msh, conf/locale.msh)
#   and pushes them live — the font layer to the shared font service, the
#   locale to this session's formatter. `theme` is locked by the system
#   layer here (an org mandate): a user may set it, but the effective theme
#   the font service applies stays the system's.
#
#   SYSTEM (the system pane): the system DEFAULT locale, from the system
#   settings layer (conf/app/locale.msh) reached through the session's conf
#   view. An administrator — whose conf view the session manager granted
#   read-write — changes it with "save system"; everyone else's view is
#   read-only and the pane says so.
#
# "log out" reverts the user's font layer and exits; the runtime closes the
# window, mshrun exits, and the manager tears the session down.

# A live sample of a locale: a medium date and a formatted number, so the
# user sees what their choice does. The formatters take the tag explicitly.
def loc-sample [tag] {
  let num = (fmt-number 1234.5 $tag)
  match (fmt-date $tag "medium") {
    ok $d => ($d + "     " + $num)
    _ => $num
  }
}

# Whether the system layer locks `theme` (the font service reports it). A
# locked axis is shown as a non-editable label, not a button.
def theme-locked [] {
  (appearance) | get "theme_locked"
}

# Apply this user's saved appearance and locale for the session first.
match (cat "conf/font.msh") {
  ok $layer => { sessionfont $layer }
  _ => null
}
match (cat "conf/locale.msh") {
  ok $l => { sessionlocale ($l | from-data | get "locale") }
  _ => null
}

# Whether this session may write the system settings layer (an admin). The
# system pane is editable only then; everyone else's conf view is read-only.
let admin = (sysconf-admin)
echo ("settings: admin=" + (match $admin { true => "true"; _ => "false" }))
echo ("settings: system " + (match $admin { true => "editable"; _ => "read-only" }))

echo ("settings: theme " + (match (theme-locked) { true => "locked"; _ => "editable" }))

let running = true
while $running {
  let cfg = match (cat "conf/font.msh") {
    ok $l => { from-data $l }
    _ => { { scale: 1.0, theme: "dark", contrast: "normal", colors: "default" } }
  }
  let myloc = match (cat "conf/locale.msh") {
    ok $l => { ($l | from-data | get "locale") }
    _ => "en-US"
  }
  let sysloc = match (sysconf-read "locale") {
    ok $t => { ($t | from-data | get "default") }
    _ => "en-US"
  }
  let r = (gui {
      init:  { scale: ($cfg | get "scale"), theme: ($cfg | get "theme"), contrast: ($cfg | get "contrast"), colors: ($cfg | get "colors"), myloc: $myloc, sysloc: $sysloc, admin: $admin, action: "" }
      title: "moss settings"
      view: (fn [state] {
          {
            kind: "column"
            children: [
              { kind: "label", role: "title", text: "settings" }
              { kind: "label", muted: true, text: "you" }
              { kind: "label", text: ("scale " + (str $state.scale)) }
              {
                kind: "row"
                children: [
                  { kind: "button", id: "smaller", label: "smaller" }
                  { kind: "button", id: "larger", label: "larger" }
                ]
              }
              {
                kind: "row"
                children: [
                  (match (theme-locked) {
                      true => { kind: "label", muted: true, text: ("theme: " + $state.theme + " (system-locked)") }
                      _ => { kind: "button", id: "theme", label: ("theme: " + $state.theme) }
                    })
                  { kind: "button", id: "contrast", label: ("contrast: " + $state.contrast) }
                  { kind: "button", id: "colors", label: ("colours: " + $state.colors) }
                ]
              }
              {
                kind: "row"
                children: [
                  { kind: "button", id: "myloc", label: ("locale: " + $state.myloc) }
                  { kind: "label", muted: true, text: (loc-sample $state.myloc) }
                ]
              }
              { kind: "button", id: "apply", label: "apply", variant: "primary" }
              { kind: "label", muted: true, text: "system" }
              { kind: "label", text: ("default locale: " + $state.sysloc) }
              (match $state.admin {
                  true => {
                    kind: "row"
                    children: [
                      { kind: "button", id: "cycleloc", label: "change locale" }
                      { kind: "button", id: "savesys", label: "save system", variant: "primary" }
                    ]
                  }
                  _ => { kind: "label", muted: true, text: "read-only (not an administrator)" }
                })
              { kind: "button", id: "logout", label: "close", variant: "danger" }
            ]
          }
        })
      update: (fn [state, ev] {
          match $ev.id {
            "smaller" => { { scale: (match (($state.scale - 0.25) < 1.0) { true => 1.0; _ => ($state.scale - 0.25) }), theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "" } }
            "larger" => { { scale: (match (($state.scale + 0.25) > 3.0) { true => 3.0; _ => ($state.scale + 0.25) }), theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "" } }
            "theme" => { { scale: $state.scale, theme: (match $state.theme { "dark" => "light"; _ => "dark" }), contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "" } }
            "contrast" => { { scale: $state.scale, theme: $state.theme, contrast: (match $state.contrast { "high" => "normal"; _ => "high" }), colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "" } }
            "colors" => { { scale: $state.scale, theme: $state.theme, contrast: $state.contrast, colors: (match $state.colors { "cb-safe" => "default"; _ => "cb-safe" }), myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "" } }
            "myloc" => { { scale: $state.scale, theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: (match $state.myloc { "en-US" => "de-DE"; "de-DE" => "fr-FR"; "fr-FR" => "ja-JP"; _ => "en-US" }), sysloc: $state.sysloc, admin: $state.admin, action: "" } }
            "cycleloc" => { { scale: $state.scale, theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: (match $state.sysloc { "en-US" => "de-DE"; "de-DE" => "fr-FR"; "fr-FR" => "ja-JP"; _ => "en-US" }), admin: $state.admin, action: "" } }
            "apply" => { { scale: $state.scale, theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "apply", done: true } }
            "savesys" => { { scale: $state.scale, theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "savesys", done: true } }
            "logout" => { { scale: $state.scale, theme: $state.theme, contrast: $state.contrast, colors: $state.colors, myloc: $state.myloc, sysloc: $state.sysloc, admin: $state.admin, action: "logout", done: true } }
            _ => $state
          }
        })
    })
  match $r.action {
    "apply" => {
      save "conf/font.msh" (to-data { scale: $r.scale, theme: $r.theme, contrast: $r.contrast, colors: $r.colors })
      sessionfont (cat "conf/font.msh")?
      save "conf/locale.msh" (to-data { locale: $r.myloc })
      sessionlocale $r.myloc
    }
    "savesys" => {
      # Write the system default locale (confcmds logs the outcome: an
      # admin's view is read-write and it saves, a plain user's is read-only
      # and it is refused). The result is discarded — inside this loop mshl
      # would drop an echo's output anyway.
      sysconf-write "locale" (to-data { default: $r.sysloc })
    }
    # "close" just ends the settings window; the session (and its appearance)
    # lives on — reverting is the top bar's job at log-out, not ours.
    _ => null
  }
  # Reopen only to re-render after a change (apply/save re-lay the window at
  # the new look); "close" and the red traffic-light (which return with no
  # action) end the app.
  let running = (match $r.action { "apply" => true; "savesys" => true; _ => false })
}
"gui: shell exited"
