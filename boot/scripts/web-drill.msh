# The web drill: the fixture servers answer, both ways, and fetch does
# what a page needs. A page fetched plain over loopback by name (dnsd
# serves www.moss.test as ::1), a page over TLS with the certificate
# verified against the trust roots in the assets tier, a request for a
# page that is not there refused with a 404; then a redirect chain
# followed (and, asked not to, shown), a gzip body inflated, a HEAD, a
# 4 MB body streamed into a file inside a 16 MB budget — and refused
# in memory — and the `web` module's wget. The servers are units of the
# same profile, so the first fetch retries while they come up.
def try-fetch [url, n] {
  match (fetch $url) {
    ok $r => (ok $r)
    err $e => (match ($n > 0) {
        true => { sleep 500; try-fetch $url ($n - 1) }
        _ => (err "fetch $url: $e")
      })
  }
}
let r = (try-fetch http://www.moss.test:8080/ 60)?
if $r.status != 200 or ($r.body | split "A moss fixture" | len) < 2 { (err "http fixture: $r.status")? }
if ($r.headers | get "content-type") != "text/html; charset=utf-8" { (err "http fixture: not html")? }
if $r.url != "http://www.moss.test:8080/" or $r.redirects != 0 { (err "http fixture: url $r.url")? }
echo "script: http fixture ok"
let s = (try-fetch https://www.moss.test:8443/about.html 60)?
if $s.status != 200 or ($s.body | split "About the fixtures" | len) < 2 { (err "https fixture: $s.status")? }
echo "script: https fixture ok"
match (fetch http://www.moss.test:8080/missing.html) {
  ok $m => { if $m.status != 404 { (err "missing page: $m.status")? } }
  err $e => (err "missing page: $e")?
}
# Redirects: three hops of three kinds land on the page, and the final
# URL and the count say so; a relative Location resolves against the
# hop it came from. Asked not to follow, the first answer is shown.
let d = (fetch http://www.moss.test:8080/r1)?
if $d.status != 200 or $d.redirects != 3 or $d.url != "http://www.moss.test:8080/about.html" { (err "redirects: $d.status $d.redirects $d.url")? }
if ($d.body | split "About the fixtures" | len) < 2 { (err "redirects: wrong page")? }
let f = (fetch http://www.moss.test:8080/r1 { follow: false })?
if $f.status != 301 or ($f.headers | get "location") != "/r2" { (err "unfollowed redirect: $f.status")? }
echo "script: redirects ok"
# A gzip body arrives compressed (the file is served as it is, with its
# coding declared) and fetch inflates it; the coding header is gone
# from what the script sees.
let g = (fetch http://www.moss.test:8080/gz)?
if $g.status != 200 or ($g.body | split "inflated by fetch" | len) < 2 { (err "gzip: $g.status")? }
if ($g.headers | keys | any { $it == "content-encoding" }) { (err "gzip: coding header kept")? }
let raw = (fetch http://www.moss.test:8080/gz { decode: false })?
if ($raw.headers | get "content-encoding") != "gzip" or (type $raw.body) != "bytes" { (err "gzip raw: not the wire bytes")? }
echo "script: gzip ok"
# HEAD: the head, its Content-Length describing the body that never comes.
let h = (fetch http://www.moss.test:8080/about.html { method: "HEAD" })?
if $h.status != 200 or $h.body != "" { (err "head: $h.status")? }
let about = (stat boot/web/about.html)?
if ($h.headers | get "content-length") != (str $about.size) { (err "head: content-length")? }
echo "script: head ok"
# Streaming: index.html sent 8192 times is a body far past the in-memory
# cap and a fair share of this unit's 16 MB — streamed into a file it
# never touches the budget; whole, it is refused.
let index = (stat boot/web/index.html)?
let want = ($index.size * 8192)
(mkdir state/webdrill)?
let big = (fetch http://www.moss.test:8080/big { to: state/webdrill/big.bin })?
let got = (stat state/webdrill/big.bin)?
if $big.status != 200 or $big.bytes != $want or $got.size != $want { (err "stream: $big.bytes of $want, file $got.size")? }
match (fetch http://www.moss.test:8080/big) {
  ok $x => (err "a 4 MB body was accepted in memory: $x.status")?
  err $e => { if ($e | split "too large" | len) < 2 { (err "big in memory: $e")? } }
}
let tbig = (fetch https://www.moss.test:8443/big { to: state/webdrill/big-tls.bin })?
if $tbig.bytes != $want { (err "stream over tls: $tbig.bytes")? }
echo "script: stream ok $want"
# The module: the wget in three lines.
let web = (use web)
let w = ($web.save http://www.moss.test:8080/r1 state/webdrill/page.html)?
if $w.status != 200 or $w.redirects != 3 or $w.bytes != $about.size { (err "web.save: $w")? }
let wh = ($web.head http://www.moss.test:8080/)?
if $wh.status != 200 { (err "web.head: $wh")? }
echo "script: web module ok"
# The engine in the shell: the page as a tree, a selector over it, its
# text — scraping, in three commands.
let doc = ($r.body | html-parse)
let titles = (($doc | html-select "head > title")? | map { $it | html-text })
if $titles != ["moss fixture: home"] { (err "html-select title: $titles")? }
let links = (($doc | html-select "a[href]")? | map { $it.attrs.href })
if $links != ["about.html"] { (err "html-select links: $links")? }
let words = ($r.body | html-text)
if ($words | split "served by moss to moss" | len) < 2 { (err "html-text: $words")? }
match ($doc | html-select "p[") { ok _ => (err "a bad selector was accepted")?; err $e => echo "script: bad selector refused: $e" }
echo "script: html ok $links"
# The cascade: the page's own sheet over the user agent's, computed.
let h1 = (($doc | html-style "h1")? | first 1)
if ($h1 | len) != 1 { (err "html-style h1: $h1")? }
let h = ($h1 | first 1 | map { $it.display })
if $h != ["block"] { (err "h1 display: $h")? }
let hc = ($h1 | map { $it.color })
if $hc != ["rgb(51, 102, 153)"] { (err "h1 color: $hc")? }
let hs = ($h1 | map { $it.font-size })
if $hs != [32.0] { (err "h1 font-size: $hs")? }
let hb = ($h1 | map { $it.border-width })
if $hb != [[0.0, 0.0, 2.0, 0.0]] { (err "h1 border: $hb")? }
let note = (($doc | html-style "p.note")? | map { $it.font-style })
if $note != ["italic"] { (err "note style: $note")? }
let sheet = ($doc | css-parse)
if ($sheet | len) != 3 { (err "css-parse: $sheet")? }
let firstsel = ($sheet | first 1 | map { $it.selector })
if $firstsel != ["h1"] { (err "css-parse selector: $firstsel")? }
echo "script: css ok"
# A headless render: a page domain, spawned from the store for the call
# and brokered by this script, loads the front page and hands back its
# document as the tree html-parse makes.
let rendered = (web-render http://www.moss.test:8080/)?
if $rendered.title != "moss fixture: home" { (err "web-render: title $rendered.title")? }
if $rendered.url != "http://www.moss.test:8080/" { (err "web-render: url $rendered.url")? }
let rh1 = (($rendered.dom | html-select "h1")? | map { $it | html-text })
if $rh1 != ["A moss fixture"] { (err "web-render: h1 $rh1")? }
match (web-render http://www.moss.test:8080/missing.html) {
  ok $m => (err "web-render: a 404 rendered as ok")?
  err $e => { if ($e | split "refused" | len) < 2 { (err "web-render 404: $e")? } }
}
echo "script: web-render ok"
echo "script: web fixtures ok"
