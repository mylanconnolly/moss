# The desktop dock — a resident bottom bar that launches the session's apps.
# Each pill opens a session unit's window on the shared compositor. A pill
# doubles as the app's presence: click it once and the app launches
# (`launch NAME` through the session's init front channel); click it again
# while the app is up — including after the amber traffic-light minimized
# its window — and the window is brought back (`restore-window TITLE`)
# instead of the app relaunching. The pill's `title` is the window title the
# compositor restores by, so they must match ("Settings", "Demo").
#
# A pill's *running* dot is not remembered state — it is polled live: the
# view asks init `unit-up NAME` for each app, and a `tick` re-renders once a
# second, so the dot lights when the app is up and clears on its own when
# the app exits (init reports a dead unit as down). No teardown signal has
# to reach the dock.
let final = (gui {
    dock: true
    tick: 1000
    init: { }
    view: (fn [state] {
        {
          items: [
            { title: "Settings", unit: "settings", running: (unit-up "settings") }
            { title: "Demo", unit: "win-demo", running: (unit-up "win-demo") }
            { title: "Files", unit: "explorer", running: (unit-up "explorer") }
          ]
        }
      })
    update: (fn [state, ev] {
        match (restore-window $ev.title) {
          ok _ => { { } }
          _ => { launch $ev.unit; { } }
        }
      })
  })
echo "dock: exit"
