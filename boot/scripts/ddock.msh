# The desktop dock — a resident bottom bar that launches the session's apps.
# Each pill opens a session unit's window on the shared compositor. A pill
# doubles as the app's presence: click it once and the app launches
# (`launch NAME` through the session's init front channel); click it again
# while the app is up — including after the amber traffic-light minimized
# its window — and the window is brought back (`restore-window TITLE`)
# instead of the app relaunching. The pill's `title` is the window title the
# compositor restores by, so they must match ("Settings", "Demo").
#
# A pill's *running* dot is not remembered state — it is polled live: the
# view reads init's application catalog (`apps`, with each unit's up flag)
# and a `tick` re-renders every second, so the dot lights when the app is
# up and clears on its own when the app exits (init reports a dead unit as
# down). No teardown signal has to reach the dock; a click re-renders at
# once, so a launch lights its dot without waiting for the tick.
# Restore only a previously confirmed preference. Unsupported modes leave
# the driver's boot mode intact; unconfirmed previews are never persisted.
match (cat "conf/display.msh") {
  ok $text => {
    match (try { from-data $text | get "mode" }) {
      ok $mode => { if (display-preview $mode) { display-confirm } }
      _ => null
    }
  }
  _ => null
}
let final = (gui {
    dock: true
    tick: 1000
    init: { }
    view: (fn [state] {
        {
          items: (apps | where dock)
        }
      })
    update: (fn [state, ev] {
        match (restore-window $ev.title) {
          ok _ => { { } }
          _ => { launch $ev.unit; { } }
        }
      })
  })
echo "dock: exit"
