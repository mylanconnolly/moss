# A remote stage: the block runs on node 1 with $in as its input. Node 1
# may not be in the mesh yet when this node boots: try for a while.
def on-node-1 [tries] {
  match ([1, 2, 3, 4] | remote 1 { $in | map { $it * $it } | reduce 0 { $acc + $it } }) {
    ok $v => ok $v
    err $e => if $tries > 0 { sleep 500; on-node-1 ($tries - 1) } else { err $e }
  }
}
let squares = (on-node-1 60)?
if $squares != 30 { (err "remote stage: wrong answer $squares")? }
echo "script: remote stage ok"
# A table crosses too, and comes back as one; a failing stage is an err.
let t = ([{ n: 1, s: a }, { n: 2, s: b }, { n: 3, s: c }] | remote 1 { $in | where n > 1 | select s })?
if ($t | len) != 2 or ($t | get s) != [b, c] { (err "remote table: wrong answer")? }
match ("x" | remote 1 { frobnicate }) { ok _ => (err "a failing stage answered ok")?; err $e => echo "script: remote failure: $e" }
# A published service on node 1: look it up and call it across the wire
# (its request buffer is proxied by the fabric, as a remote stage's is).
def svc-on-1 [tries] {
  match (lookup 1 3) {
    ok $s => match (21 | call $s) {
      ok $v => ok $v
      err $e => if $tries > 0 { sleep 500; svc-on-1 ($tries - 1) } else { err $e }
    }
    err $e => if $tries > 0 { sleep 500; svc-on-1 ($tries - 1) } else { err $e }
  }
}
let doubled = (svc-on-1 120)?
if $doubled != 42 { (err "service via lookup: wrong answer $doubled")? }
echo "script: service via lookup ok"
# Two sessions to the same service, called alternately with different
# inputs: each must keep its own request buffer. A shared one desyncs
# each session's shadow across the wire and corrupts the third call.
let sa = (lookup 1 3)?
let sb = (lookup 1 3)?
let m1 = (10 | call $sa)?
let m2 = (20 | call $sb)?
let m3 = (5 | call $sa)?
if $m1 != 20 or $m2 != 40 or $m3 != 10 { (err "multi-client: $m1 $m2 $m3")? }
echo "script: multi-client ok"
# A durable service UNIT on node 1, reached across the wire: node 1's
# init starts and supervises it on demand — no keep-alive loop anywhere,
# unlike the published worker above. dial NODE SERVICE, service 4 is the
# doubler unit. Node 1 may still be settling, so try for a while.
def dial-on-1 [tries] {
  match (dial 1 doubler) {
    ok $s => match (7 | call $s) {
      ok $v => ok $v
      err $e => if $tries > 0 { sleep 500; dial-on-1 ($tries - 1) } else { err $e }
    }
    err $e => if $tries > 0 { sleep 500; dial-on-1 ($tries - 1) } else { err $e }
  }
}
let dd = (dial-on-1 120)?
if $dd != 14 { (err "remote dial: wrong answer $dd")? }
echo "script: remote dial ok"
echo "script: remote stages done"
