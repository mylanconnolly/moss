# A movable demo window (the desktop drill, window A). It opens narrow,
# where the `at` places it, with a draggable traffic-light titlebar (the
# runtime draws it). Closing it (the red dot) ends the app.
let final = (gui {
    init:  { n: 0 }
    title: "Alpha"
    width: 320
    at:    { x: 120, y: 200 }
    view: (fn [state] {
        {
          kind: "column"
          children: [
            { kind: "label", text: ("clicks: " + (str $state.n)) }
            { kind: "button", id: "tap", label: "tap me", variant: "primary" }
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "tap" => { { n: ($state.n + 1) } }
          _ => $state
        }
      })
  })
echo "win-alpha: closed"
