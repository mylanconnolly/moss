# Web: the browser. Tabs are page domains — each tab's `page` leaf in
# the view is a sandboxed process that loads through this window's own
# broker and paints into a buffer the runtime blits inside the leaf's
# rect; the address bar above it is this window's pixels, whatever the
# page paints. The app is pure: its state is the tab list, and every
# event — a button, the tab strip, a page's title, URL, load state,
# hover, selection, focus, a download or death — is a coarse record
# to `update`.
#
# State: { tabs: [{ id, url, title, state, code, hover, gen, nav, back,
# fwd, skip }], active: the shown tab's id, next: the next tab number,
# bookmarks: [{ url, title }], show: "" | "bookmarks" | "site", find,
# find_nav, fgen, zoom, note }. A tab's `gen` renumbers its address
# field when the page reports its final URL (a field keeps its own text
# by id); `nav` is a nonce that makes the page reload the same URL;
# `back`/`fwd` are its history, `skip` marks a history move so the URL
# the page reports for it is not pushed again. Bookmarks persist under
# the home's state/browser/ as data; history lines go to history.msh.

let store = "state/browser"

# The home page: `state/browser/home.msh` in the home holds a URL as
# data; without one the first tab is a New Tab (the fixture home of the
# drills is a page a hand-run desktop can never reach).
def load-home [] {
  match (cat ($store + "/home.msh")) {
    ok $text => (match ($text | from-data) {
        ok $v => (match $v { $u => $u })
        _ => ""
      })
    _ => ""
  }
}
let home = (load-home)

def new-tab [id, url] {
  { id: $id, url: $url, title: "", state: "loading", code: 0, hover: "", gen: 0, nav: 0, back: [], fwd: [], skip: false }
}

def active-tab [state] {
  $state.tabs | find (fn [t] { $t.id == $state.active })
}

def tab-index [tabs, active] {
  let r = ($tabs | reduce { i: 0, sel: 0 } {
      match ($it.id == $active) {
        true => ({ i: ($acc.i + 1), sel: $acc.i })
        _ => ({ i: ($acc.i + 1), sel: $acc.sel })
      }
    })
  $r.sel
}

def tab-at [tabs, index] {
  $tabs | first ($index + 1) | last 1 | map { $it.id } | join ""
}

def set-tab [state, id, changes] {
  $state | merge { tabs: ($state.tabs | map (fn [t] {
          match ($t.id == $id) {
            true => ($t | merge $changes)
            _ => $t
          }
        })) }
}

def normalize [url] {
  match ($url | split "://" | len) {
    1 => ("http://" + $url)
    _ => $url
  }
}

# Navigate the active tab to a URL the user chose: the page it shows
# joins the back list, and forward is forgotten.
def go [state, url] {
  let cur = (active-tab $state)
  set-tab $state $cur.id { url: (normalize $url), nav: ($cur.nav + 1), state: "loading", hover: "", back: ($cur.back + [$cur.url]), fwd: [], skip: false }
}

def load-bookmarks [] {
  match (cat ($store + "/bookmarks.msh")) {
    ok $text => (match ($text | from-data) {
        ok $v => $v
        _ => []
      })
    _ => []
  }
}

def save-bookmarks [marks] {
  match (mkdir $store) {
    _ => ""
  }
  save ($store + "/bookmarks.msh") (to-data $marks)
}

def note-history [url] {
  match (mkdir $store) {
    _ => ""
  }
  let old = (match (cat ($store + "/history.msh")) { ok $t => $t; _ => "" })
  save ($store + "/history.msh") ($old + $url + "\n")
}

def status-line [state, tab] {
  let verdict = (match $tab.state {
      "loading" => "Loading"
      "done" => (match ($tab.url | split "https://" | len) {
          2 => "Secure: the connection was verified against the trust roots"
          _ => "Not secure: plain http"
        })
      "failed" => ("Could not load the page (" + (str $tab.code) + ")")
      "crashed" => "The page crashed; reload to try again"
      _ => $tab.state
    })
  let with_note = (match $state.note {
      "" => $verdict
      _ => ($verdict + "  |  " + $state.note)
    })
  match $tab.hover {
    "" => $with_note
    _ => ($with_note + "  ->  " + $tab.hover)
  }
}

def site-panel [state, tab] {
  let info = (page-info $tab.id)
  let origin = ($tab.url | split "/" | first 3 | join "/")
  { kind: "section", title: "Site", children: [
      { kind: "label", text: ("Origin: " + $origin) }
      { kind: "label", text: ("Page domain: " + (match $info.alive { true => "alive"; _ => "gone" }) + ", " + (str $info.used_kb) + " KB of " + (str $info.limit_kb) + " KB") }
      { kind: "label", muted: true, wrap: true, text: "The page holds one channel to this window and nothing else: no filesystem, no network of its own, no cookies yet. What it fetches goes through this window's broker." }
    ] }
}

let final = (gui {
    init:  { tabs: [(new-tab "t1" $home)], active: "t1", next: 2, bookmarks: (load-bookmarks), show: "", find: "", find_nav: 0, fgen: 0, zoom: 100, note: "" }
    title: "Web"
    width: 1000
    view: (fn [state] {
        let cur = (active-tab $state)
        let idx = (tab-index $state.tabs $state.active)
        # The chrome's buttons are Phosphor glyphs (icon_only keeps the
        # label as the button's name, which the drill clicks by id).
        let chrome = [
          { kind: "tabs", id: "tabs", bar: true, items: ($state.tabs | map { match $it.title { "" => "New Tab"; _ => $it.title } }), selected: $idx }
          { kind: "row", gap: 6, children: [
              { kind: "button", id: "back", label: "Back", icon: "caret-left", icon_only: true, disabled: ((len $cur.back) == 0) }
              { kind: "button", id: "forward", label: "Forward", icon: "caret-right", icon_only: true, disabled: ((len $cur.fwd) == 0) }
              { kind: "button", id: "reload", label: "Reload", icon: "arrow-clockwise", icon_only: true }
              { kind: "field", id: ("url-" + $cur.id + "-" + (str $cur.gen)), flex: 1, value: $cur.url }
              { kind: "button", id: "go", label: "Go", icon: "arrow-right", icon_only: true, variant: "primary" }
              { kind: "button", id: "newtab", label: "New Tab", icon: "plus", icon_only: true }
              { kind: "button", id: "closetab", label: "Close Tab", icon: "x", icon_only: true, disabled: ((len $state.tabs) < 2) }
            ] }
          { kind: "row", gap: 6, children: [
              { kind: "button", id: "bookmark", label: "Bookmark", icon: "bookmark-simple", icon_only: true }
              { kind: "button", id: "bookmarks", label: (str (len $state.bookmarks)), icon: "bookmarks-simple" }
              { kind: "field", id: ("find-" + (str $state.fgen)), flex: 1, value: $state.find }
              { kind: "button", id: "find", label: "Find", icon: "magnifying-glass", icon_only: true }
              { kind: "button", id: "zoomout", label: "Zoom out", icon: "magnifying-glass-minus", icon_only: true }
              { kind: "label", text: ((str $state.zoom) + "%") }
              { kind: "button", id: "zoomin", label: "Zoom in", icon: "magnifying-glass-plus", icon_only: true }
              { kind: "button", id: "site", label: "Site", icon: "info", icon_only: true }
            ] }
        ]
        let panel = (match $state.show {
            "bookmarks" => [{ kind: "list", id: "bmlist", key: "bookmarks", h: 120, cols: [{ title: "Title", w: 2 } { title: "URL", w: 3 }], rows: ($state.bookmarks | map { { id: $it.url, cells: [$it.title, $it.url] } }), empty: "No bookmarks yet." }]
            "site" => [(site-panel $state $cur)]
            _ => []
          })
        let pages = ($state.tabs | map (fn [t] { { kind: "page", id: $t.id, url: $t.url, nav: $t.nav, visible: ($t.id == $state.active), h: 520, grow: true, zoom: $state.zoom, find: $state.find, find_nav: $state.find_nav } }))
        let status = [{ kind: "label", muted: true, text: (status-line $state $cur) }]
        # The pages share one gap-less column: a hidden tab's leaf takes no
        # room at all, so the window's height is the shown page's. (`map`
        # yields a table; adding a list makes the list `children` wants.)
        { kind: "column", gap: 6, children: ($chrome + $panel + [{ kind: "column", gap: 0, grow: true, children: ([] + $pages) }] + $status) }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "go" => {
            # The field the event carries was rendered before any page
            # event that renumbered it (a failing load bumps `gen` on
            # every report), so the value is looked up by the newest
            # numbering the event knows; none known, the address stands.
            let cur = (active-tab $state)
            let known = ($ev.fields | keys)
            let hit = (range 0 12 | map { "url-" + $cur.id + "-" + (str ($cur.gen - $it)) } | find (fn [c] { $known | any (fn [k] { $k == $c }) }))
            let typed = (match $hit { nothing => $cur.url; $k => ($ev.fields | get $k) })
            go ($state | merge { note: "" }) $typed
          }
          "back" => {
            let cur = (active-tab $state)
            match ((len $cur.back) == 0) {
              true => $state
              _ => (set-tab $state $cur.id { url: ($cur.back | last 1 | join ""), back: ($cur.back | first ((len $cur.back) - 1)), fwd: ([$cur.url] + $cur.fwd), nav: ($cur.nav + 1), state: "loading", skip: true })
            }
          }
          "forward" => {
            let cur = (active-tab $state)
            match ((len $cur.fwd) == 0) {
              true => $state
              _ => (set-tab $state $cur.id { url: ($cur.fwd | first 1 | join ""), fwd: ($cur.fwd | last ((len $cur.fwd) - 1)), back: ($cur.back + [$cur.url]), nav: ($cur.nav + 1), state: "loading", skip: true })
            }
          }
          "reload" => {
            let cur = (active-tab $state)
            set-tab $state $cur.id { nav: ($cur.nav + 1), state: "loading" }
          }
          "newtab" => {
            let id = ("t" + (str $state.next))
            $state | merge { tabs: ($state.tabs + [(new-tab $id "")]), active: $id, next: ($state.next + 1), note: "" }
          }
          "closetab" => (match ((len $state.tabs) < 2) {
              true => $state
              _ => {
                let rest = ($state.tabs | filter (fn [t] { $t.id != $state.active }))
                $state | merge { tabs: $rest, active: (tab-at $rest 0) }
              }
            })
          "tabs" => (match ($ev.col >= 0) {
              true => ($state | merge { active: (tab-at $state.tabs $ev.col), note: "" })
              _ => $state
            })
          "bookmark" => {
            let cur = (active-tab $state)
            match ($state.bookmarks | any { $it.url == $cur.url }) {
              true => ($state | merge { note: "Already bookmarked" })
              _ => {
                let marks = ($state.bookmarks + [{ url: $cur.url, title: (match $cur.title { "" => $cur.url; _ => $cur.title }) }])
                match (save-bookmarks $marks) {
                  ok _ => { log ("browser: bookmarked " + $cur.url) }
                  err $e => { log ("browser: bookmark not saved: " + $e) }
                }
                $state | merge { bookmarks: $marks, note: "Bookmarked" }
              }
            }
          }
          "bookmarks" => ($state | merge { show: (match $state.show { "bookmarks" => ""; _ => "bookmarks" }) })
          "bmlist" => (match ($ev.col >= 0) {
              true => $state
              _ => (match $ev.activated {
                  true => (go ($state | merge { show: "", note: "" }) $ev.row)
                  _ => $state
                })
            })
          "site" => ($state | merge { show: (match $state.show { "site" => ""; _ => "site" }) })
          "find" => ($state | merge { find: ($ev.fields | get ("find-" + (str $state.fgen))), find_nav: ($state.find_nav + 1), note: "" })
          "zoomin" => ($state | merge { zoom: (match (($state.zoom + 25) > 300) { true => 300; _ => ($state.zoom + 25) }) })
          "zoomout" => ($state | merge { zoom: (match (($state.zoom - 25) < 50) { true => 50; _ => ($state.zoom - 25) }) })
          _ => (match $ev.kind {
              "title" => (set-tab $state $ev.id { title: $ev.text })
              "url" => {
                let t = ($state.tabs | find (fn [t] { $t.id == $ev.id }))
                # The same URL reported again (a failed load reports it
                # on every retry) keeps the address field as it is: a
                # renumbering resets what the user is typing into it.
                match ($t.url == $ev.text) {
                  true => (set-tab $state $ev.id { skip: false })
                  _ => {
                    note-history $ev.text
                    match $t.skip {
                      true => (set-tab $state $ev.id { url: $ev.text, gen: ($t.gen + 1), skip: false })
                      _ => (set-tab $state $ev.id { url: $ev.text, gen: ($t.gen + 1), back: ($t.back + [$t.url]), fwd: [] })
                    }
                  }
                }
              }
              "load" => (set-tab $state $ev.id { state: $ev.text, code: $ev.code })
              "hover" => (set-tab $state $ev.id { hover: $ev.text })
              "crashed" => (set-tab $state $ev.id { state: "crashed" })
              "unavailable" => (set-tab $state $ev.id { state: ("No page host: " + $ev.text) })
              "found" => ($state | merge { note: (match $ev.code { 0 => "Not found"; _ => ("Match " + (str ((int $ev.text)? + 1)) + " of " + (str $ev.code)) }) })
              "selection" => ($state | merge { note: ("Selected " + (str (len $ev.text)) + " characters; Copy takes them") })
              "focus" => $state
              "download" => {
                let name = ($ev.text | split "/" | last 1 | join "")
                match (fetch $ev.text) {
                  ok $r => (match (save-as $name $r.body) {
                      ok $s => {
                        log ("browser: saved " + $s.name + " " + (str $s.bytes))
                        $state | merge { note: ("Saved " + $s.name) }
                      }
                      err $e => {
                        log ("browser: download not saved: " + $e)
                        $state | merge { note: ("Download not saved: " + $e) }
                      }
                    })
                  err $e => ($state | merge { note: ("Download failed: " + $e) })
                }
              }
              _ => $state
            })
        }
      })
  })
echo ("browser: closed tabs=" + (str (len $final.tabs)))
