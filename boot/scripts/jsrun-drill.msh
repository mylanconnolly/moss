# The JavaScript drill: programs run in script domains, holding nothing
# but the channel to this script, and what they print and return comes
# back through it. A program with classes, a Map, a template literal and
# a sort; one that throws (an error result naming the exception); one
# that is not JavaScript at all (a syntax error); and one that recurses
# without end (the engine's own stack limit, not the domain's death).
let prog = "let a = [3, 1, 2].sort(); print('sorted', a.join(',')); class P { #x = 2; get x() { return this.#x; } } const m = new Map([[1, 'one']]); print('map ' + m.get(1)); a.length * 10 + new P().x"
let r = (js-run $prog)?
if $r.value != "32" { (err "js-run: value $r.value")? }
if $r.lines != ["sorted 1,2,3", "map one"] { (err "js-run: lines $r.lines")? }
echo "script: js-run value ok"
match (js-run "throw new TypeError('boom')") {
  ok $v => (err "js-run: a throw came back ok")?
  err $e => { if ($e | split "boom" | len) < 2 { (err "js-run throw: $e")? } }
}
match (js-run "let let = 1") {
  ok $v => (err "js-run: a syntax error came back ok")?
  err $e => { if ($e | split "SyntaxError" | len) < 2 { (err "js-run syntax: $e")? } }
}
match (js-run "function f() { return f() + 1; } f()") {
  ok $v => (err "js-run: a runaway came back ok")?
  err $e => { if ($e | split "RangeError" | len) < 2 { (err "js-run runaway: $e")? } }
}
let again = (js-run "[1, 2, 3].map(x => x * x).reduce((a, b) => a + b)")?
if $again.value != "14" { (err "js-run again: $again.value")? }
# Modules over the domain's one capability: a directory of this
# script's view, lent to the program as `moss:fs` and as the place its
# relative imports come from; a program lent nothing finds no module.
(mkdir state/jsdrill)?
(write state/jsdrill/lib.js "export const twice = x => x * 2;")?
let mod = "import { twice } from './lib.js'; import { read, write, list, exists } from 'moss:fs'; console.log('lib', twice(21)); write('note.txt', 'hello from js'); console.log(read('note.txt')); console.log(list('.').map(e => e.name).sort().join(',')); console.log(exists('nope.txt'), await Promise.resolve('awaited'));"
let m = (js-run $mod { fs: state/jsdrill, module: true })?
if $m.lines != ["lib 42", "hello from js", "lib.js,note.txt", "false awaited"] { (err "js-run module: lines $m.lines")? }
if (cat state/jsdrill/note.txt)? != "hello from js" { (err "js-run module: the file was not written")? }
echo "script: js-run modules ok"
match (js-run "import { read } from 'moss:fs'; read('note.txt')" { module: true }) {
  ok $v => (err "js-run: a program lent nothing reached a view")?
  err $e => { if ($e | split "moss:fs" | len) < 2 { (err "js-run no view: $e")? } }
}
match (js-run "import { read } from 'moss:fs'; read('../fs.key')" { fs: state/jsdrill, module: true }) {
  ok $v => (err "js-run: a program read outside its view")?
  err $e => { if ($e | split "not_found" | len) < 2 { (err "js-run escape: $e")? } }
}
echo "script: jsrun ok"
