# The mshl GUI demo (profile gui): a GUI defined as a service — a pure
# `view` (state -> a declarative widget tree) and `update` (state, event
# -> state). The runtime owns the surface, renders the view, routes the
# keyboard (Tab moves between the buttons, Enter fires the focused one),
# and threads the returned state forward. No loop, no drawing here.
let final = (gui {
    init:  { count: 0, done: false, name: "", other: "", secret_len: 0 }
    title: "Moss · Components"
    view: (fn [state] {
        {
          kind: "column"
          gap:  20
          children: [
            { kind: "label", role: "title", text: "A place for everything" }
            { kind: "label", muted: true, text: "The shared building blocks of a Moss window." }
            { kind: "row", children: [
                { kind: "icon", name: "folder", size: 32 }
                { kind: "icon", name: "file-text", size: 32 }
                { kind: "icon", name: "gear-six", size: 32 }
                { kind: "icon", name: "terminal-window", size: 32 }
                { kind: "icon", name: "house", size: 32 }
                { kind: "icon", name: "tree-structure", size: 32 }
              ] }
            {
              kind: "section"
              children: [
                { kind: "label", text: "Actions" }
                { kind: "label", muted: true, text: ("Count: " + (str $state.count)) }
                {
                  kind: "row"
                  children: [
                    { kind: "button", id: "inc", icon: "up", label: "Increment", variant: "primary" }
                    { kind: "button", id: "quit", icon: "close", icon_only: true, label: "Close gallery" }
                    { kind: "button", id: "unavailable", icon: "lock", label: "Unavailable", disabled: true }
                  ]
                }
              ]
            }
            {
              kind: "scroll"
              id:   "editing"
              h:    180
              child: {
                kind: "section"
                children: [
                  { kind: "label", text: "Text input" }
                  { kind: "field", id: "name", label: "Display name", value: "Moss" }
                  { kind: "label", wrap: true, muted: true, text: "Copy and paste with Command + C / V. Undo with Command + Z. Scroll or Tab to reach the next field; its focus and text survive redraws." }
                  { kind: "field", id: "other", label: "Paste here", value: "" }
                  { kind: "field", id: "password", label: "Password (copy disabled)", value: "private", secret: true }
                  { kind: "label", wrap: true, muted: true, text: "Control + A / E move to the start and end. Control + Y keeps its Emacs yank behavior." }
                ]
              }
            }
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "inc" => { { count: ($state.count + 1), done: $state.done, name: $state.name, other: $state.other, secret_len: $state.secret_len } }
          "quit" => { { count: $state.count, done: true, name: $ev.fields.name, other: $ev.fields.other, secret_len: (len $ev.fields.password) } }
          _ => $state
        }
      })
  })
"gui: done count=" + (str $final.count) + " name=" + $final.name + " other=" + $final.other + " secret_len=" + (str $final.secret_len)
