# Activity: what this session is running and what it costs, and the
# machine underneath. The panel on top is the machine (sys-stats): CPU
# and memory history, a load bar per core, cores and uptime. The Session
# tab is one row per unit the session's init supervises (an app under its
# display name and icon, a service under its unit name), with its state,
# CPU, memory, threads and restarts, refreshed every second from
# `unit-rows`; select a row to show its window, launch it if it is down,
# or force-quit it (init destroys the domain; a confirm step stands
# between the button and the kill). The System tab is every domain on
# the machine as a tree (`domain-rows`), which the session's init grants
# only to an administrator; anyone else sees the tab say so. Click a
# column header to sort by it.
#
# State: { tab, sort, sel, confirm, note }. sel = the selected unit's id.

def sort-of [col] {
  match $col {
    0 => "name"
    1 => "state"
    2 => "cpu"
    3 => "mem"
    4 => "threads"
    5 => "restarts"
    _ => "name"
  }
}

def dsort-of [col] {
  match $col {
    0 => "name"
    1 => "id"
    2 => "state"
    3 => "cpu"
    4 => "mem"
    5 => "kobj"
    6 => "threads"
    _ => "name"
  }
}

def col-of [sort] {
  match $sort {
    "name" => 0
    "id" => 1
    "state" => 1
    "cpu" => 2
    "mem" => 3
    "threads" => 4
    "restarts" => 5
    _ => 0
  }
}

def dcol-of [sort] {
  match $sort {
    "name" => 0
    "id" => 1
    "state" => 2
    "cpu" => 3
    "mem" => 4
    "kobj" => 5
    "threads" => 6
    _ => 0
  }
}

# The state with one field changed; everything else carried.
def with [state, tab, sort, sel, confirm, note] {
  { tab: $tab, sort: $sort, sel: $sel, confirm: $confirm, note: $note }
}

def same [state] {
  with $state $state.tab $state.sort $state.sel "" ""
}

let final = (gui {
    init:  { tab: 0, sort: "name", sel: "", confirm: "", note: "" }
    title: "Activity"
    width: 760
    tick:  1000
    view: (fn [state] {
        let m = (sys-stats)
        let t = (unit-rows $state.sort $state.sel)
        let d = (match $state.tab {
            1 => (domain-rows $state.sort)
            _ => { rows: [], available: false, summary: "" }
          })
        let have = $t.have
        let up = $t.up
        let windowed = ($t.window != "")
        let shown = $t.name
        {
          kind: "column"
          gap:  12
          children: [
            { kind: "row", children: [
                { kind: "label", role: "title", flex: 1, text: "Activity" }
                { kind: "label", muted: true, text: $m.machine_text }
              ] }
            { kind: "row", gap: 16, align: "top", children: [
                { kind: "column", flex: 3, gap: 8, children: [
                    { kind: "chart", h: 110, title: "CPU", caption: $m.cpu_text, values: $m.cpu_history }
                    { kind: "meter", labels: "C", values: $m.cores_pm }
                  ] }
                { kind: "column", flex: 2, gap: 8, children: [
                    { kind: "chart", h: 110, title: "Memory", caption: $m.mem_text, values: $m.mem_history }
                    { kind: "label", muted: true, wrap: true, text: $t.summary }
                  ] }
              ] }
            { kind: "tabs", id: "tabs", items: ["Session", "System"], selected: $state.tab }
            (match $state.tab {
                1 => {
                  kind: "list", id: "domains", key: "domains", h: 300, fit: true
                  sort:  (dcol-of $state.sort)
                  empty: "The System view needs an administrator's session."
                  cols:  [{ title: "Name", w: 9 } { title: "Id", w: 2, right: true } { title: "State", w: 3 } { title: "CPU", w: 3, right: true } { title: "Memory", w: 6, right: true } { title: "Kernel objects", w: 6, right: true } { title: "Threads", w: 4, right: true }]
                  rows:  $d.rows
                }
                _ => {
                  kind: "list", id: "procs", key: "procs", h: 300, fit: true
                  selected: $state.sel
                  sort:     (col-of $state.sort)
                  empty:    "Nothing is running."
                  cols:     [{ title: "Name", w: 10 } { title: "State", w: 6 } { title: "CPU", w: 3, right: true } { title: "Memory", w: 7, right: true } { title: "Threads", w: 4, right: true } { title: "Restarts", w: 4, right: true }]
                  rows:     $t.rows
                }
              })
            (match $state.tab {
                1 => { kind: "label", muted: true, wrap: true, text: $d.summary }
                _ => (match $state.confirm {
                    "" => { kind: "row", gap: 8, children: [
                        { kind: "button", id: "show", label: "Show Window", disabled: (not ($have and $up and $windowed)) }
                        { kind: "button", id: "launch", label: "Launch", disabled: (not ($have and (not $up))) }
                        { kind: "button", id: "quit", label: "Force Quit", variant: "danger", disabled: (not ($have and $up)) }
                        { kind: "label", muted: true, flex: 1, text: $state.note }
                      ] }
                    _ => { kind: "row", gap: 8, children: [
                        { kind: "button", id: "cancel", label: "Cancel" }
                        { kind: "button", id: "confirm-quit", label: "Force Quit", variant: "danger" }
                        { kind: "label", flex: 1, text: ("Force quit “" + $shown + "”? Unsaved work in it is lost.") }
                      ] }
                  })
              })
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "tabs" => (match ($ev.col >= 0) {
              true => (with $state $ev.col "name" $state.sel "" "")
              _ => $state
            })
          "domains" => (match ($ev.col >= 0) {
              true => (with $state $state.tab (dsort-of $ev.col) $state.sel "" "")
              _ => $state
            })
          "procs" => (match ($ev.col >= 0) {
              true => (with $state $state.tab (sort-of $ev.col) $state.sel "" "")
              _ => (match $ev.activated {
                  true => {
                    let w = ((unit-rows $state.sort $ev.row) | get "window")
                    match ($w != "") {
                      true => { restore-window $w; (with $state $state.tab $state.sort $ev.row "" "") }
                      _ => (with $state $state.tab $state.sort $ev.row "" "")
                    }
                  }
                  _ => (with $state $state.tab $state.sort $ev.row "" "")
                })
            })
          "show" => {
            let w = ((unit-rows $state.sort $state.sel) | get "window")
            match (restore-window $w) {
              ok _ => (same $state)
              _ => (with $state $state.tab $state.sort $state.sel "" "Its window is not open.")
            }
          }
          "launch" => { launch $state.sel; (with $state $state.tab $state.sort $state.sel "" ("Launched " + $state.sel)) }
          "quit" => (with $state $state.tab $state.sort $state.sel $state.sel "")
          "cancel" => (same $state)
          "confirm-quit" => (match (unit-stop $state.confirm) {
              true => (with $state $state.tab $state.sort $state.sel "" ("Stopped " + $state.confirm))
              _ => (with $state $state.tab $state.sort $state.sel "" ("Could not stop " + $state.confirm))
            })
          "close" => { { tab: $state.tab, sort: $state.sort, sel: $state.sel, confirm: "", note: "", done: true } }
          _ => $state
        }
      })
  })
echo ("activity: closed sort=" + $final.sort)
