# The GUI front door (profile gsession): a trusted-path login form (pure
# view/update) collects credentials, then `login` hands them to the
# session manager, which unseals the identity and opens a real session
# under the user's budgets with a view of their home. The form is data;
# the login is the one side effect, a pipeline step after the form, not
# something inside the pure update. On success the session runs to
# completion and is torn down; we report who signed in.
#
# `tick: 1000` makes the runtime re-render every second even with no
# input, so the clock the `view` reads from `(date)` stays live. The time
# is read fresh on each render; a system with no wall clock shows dashes.

# The clock and date come from the CLDR locale layer (fmt-time/fmt-date),
# so the month names, the 12/24-hour choice, and the ordering all follow
# the locale — no hardcoded tables here. Dashes when there is no clock yet.
def clock-now [] {
  match (fmt-time "en-US") {
    ok $t => $t
    err _ => "--:--:--"
  }
}

def date-now [] {
  match (fmt-date "en-US" "medium") {
    ok $d => $d
    err _ => ""
  }
}

let creds = (gui {
    init:    { user: "", pass: "", done: false }
    title:   "moss"
    trusted: true
    tick:    1000
    view: (fn [state] {
        {
          kind: "column"
          children: [
            { kind: "label", role: "title", text: (clock-now) }
            { kind: "label", muted: true, text: (date-now) }
            { kind: "label", text: "sign in to moss" }
            { kind: "field", id: "user", label: "user" }
            { kind: "field", id: "pass", label: "pass", secret: true }
            { kind: "button", id: "login", label: "sign in", variant: "primary" }
          ]
        }
      })
    update: (fn [state, ev] {
        match $ev.id {
          "login" => { { user: $ev.fields.user, pass: $ev.fields.pass, done: true } }
          _ => $state
        }
      })
  })
match (login $creds.user $creds.pass) {
  ok $s => { "gui: session ok who=" + $s.who }
  err $e => { "gui: session failed " + $e }
}
