# The time service's settings in cluster addressing: node 1 is the
# fabric's time source (its own RTC under QEMU); every node asks it by
# name (resolved via the node's own dnsd to 10.77.0.1), so the fabric
# agrees on one clock and the addressing is a name, not a literal.
{ servers: [node1.moss.test], serve: true, interval: 3600 }
