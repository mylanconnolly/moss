# The desktop drill, window A (profile desktop): mshrun runs a movable GUI
# window on the pointer-capable compositor. Two such windows share one
# compositor; the drill drags one, clicks the other to raise it, and closes
# both by their traffic-light dots. Essential: the boot follows them.
{
  app:       { name: "Alpha", description: "The desktop drill's first window", icon: squares-four, window: "Alpha", dock: false, order: 900 }
  image:     mshrun
  script:    scripts/win-alpha.msh
  grant:     [log, bootfs]
  budget:    { user: 24mb }
  profiles:  [desktop, activity]
  essential: false
  give: [
    { tag: display, unit: compositor-ptr }
    { tag: font, unit: fontsvc }
  ]
}
