# The DNS-over-TLS forwarder: binds UDP 53 on its view and forwards each
# query to the upstream over TLS, verifying the server against the trust
# roots it reads from a read-only view of the assets tier (reloaded when
# they change). In the dot drill netsvc's resolver points at it (::1,
# from conf/net.msh). Settings (upstream, name, roots path) come as a
# file, staged through the buffer.
{ image: dotd, grant: [log], profiles: [dot],
  give: [{ tag: net, netview: net }, { tag: view, fs: assets, ro: true },
    { tag: buf, shm: 1 }, { file: conf/dot.msh }] }
