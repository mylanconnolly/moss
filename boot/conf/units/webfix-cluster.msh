# The fixture web server on the cluster stack (profile webnode, node 2 of
# the two-node browser drill): the same boot/web/ pages as webfix, served
# on 8080 over net-cluster, so node 1's broker fetches them across the
# hub as node2.moss.test (dnsd-cluster's name for this node).
{ image: mshrun, script: scripts/webfix.msh, grant: [log, bootfs], budget: { user: 16mb }, profiles: [webnode],
  give: [{ tag: net, netview: net-cluster }, { tag: view, fs: boot/web, ro: true }] }
