# The session manager and key custodian: user records (ro), the home
# tier (rw), the system settings layer (ro), and spawn authority for the
# sessions it opens — each a domain under its user's budgets.
{
  image:  users
  arg:    1
  budget: { user: 40mb }
  grant:  [log, spawner, bootfs]
  give: [
    { tag: view, fs: conf/users, ro: false, mkdir: true }
    { tag: home, fs: home, ro: false }
    { tag: shares, fs: conf/shares, ro: false, mkdir: true }
    { tag: conf, fs: conf/app, ro: true, mkdir: true }
    { tag: store, fs: img, ro: true }
  ]
}
