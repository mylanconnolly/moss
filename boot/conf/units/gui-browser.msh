# The GUI front door for the browser drill (profile browser): the
# gui-guishell login form, handing the session to usersvc-browser.
{
  image:     mshrun
  script:    scripts/gui-session.msh
  grant:     [log, bootfs]
  budget:    { user: 24mb }
  profiles:  [browser]
  essential: true
  after:     apply
  give: [
    { tag: display, unit: compositor-ptr }
    { tag: font, unit: fontsvc }
    { tag: sess, unit: usersvc-browser }
    { tag: buf, shm: 1 }
    { tag: locale, unit: localesvc }
    { secret: conf/trust.token }
  ]
}
