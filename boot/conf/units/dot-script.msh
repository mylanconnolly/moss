# The DNS-over-TLS drill: a script resolves a name; netsvc's resolver
# forwards the query through dotd, which asks the upstream over TLS. It
# also holds a read/write view of the assets tier, to overwrite the
# trust roots mid-run and prove dotd picks the change up with no restart.
{ image: mshrun, script: scripts/dot-drill.msh, grant: [log, bootfs], profiles: [dot], oneshot: true, essential: true,
  give: [{ tag: net, netview: net }, { tag: view, fs: assets, ro: false }] }
