# The fixture web server, plain: mshrun serving boot/web/ on 8080 over
# loopback (profile web). What every web drill fetches from.
{ image: mshrun, script: scripts/webfix.msh, grant: [log, bootfs], budget: { user: 16mb }, profiles: [web],
  give: [{ tag: net, netview: net }, { tag: view, fs: boot/web, ro: true }] }
