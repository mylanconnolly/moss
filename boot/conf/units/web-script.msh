# The web drill's client: a script fetches the fixtures plain and over
# TLS (the trust roots read from the assets tier through a root view,
# writable for the streamed download under state/webdrill). The budget
# is the point of the streaming step: 16 MB, with mshrun's own image
# most of it, cannot hold the 4 MB body twice. Essential and oneshot:
# its exit ends the boot.
{ image: mshrun, script: scripts/web-drill.msh, grant: [log, bootfs], budget: { user: 16mb }, profiles: [web], oneshot: true, essential: true,
  give: [{ tag: net, netview: net }, { tag: view, fs: "", ro: false }] }
