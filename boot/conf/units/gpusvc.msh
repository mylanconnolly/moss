# The display server (virtio-gpu). It brings up scanout 0 and then serves
# the surface protocol — clients create a surface (a shared pixel buffer)
# and commit damage rects, which it copies into the scanout and flushes.
# Activated on demand by whoever needs a display (the gpu drill's client
# pulls it up). The framebuffer backing wants ~300 DMA pages, so the
# budget is generous.
{
  image:  gpusvc
  arg:    0
  budget: { user: 16mb }
  give: [
    { tag: device, device: gpu }
  ]
}
