# The desktop dock (resident, eager, non-essential): a bottom bar that
# launches the session's apps through the session init front channel. Not
# essential — if it exits the session lives on (the top bar is the anchor).
{
  image:     mshrun
  script:    scripts/ddock.msh
  budget:    { user: 16mb }
  grant:     [log, bootfs]
  profiles:  [session]
  essential: false
  restart:   { max: 5 }
  give: [
    { tag: display, session: true }
    { tag: display_control, session: true }
    { tag: font, session: true }
    { tag: view, fs: "", ro: true }
    { tag: init, self: true }
  ]
}
