# Per-session document broker: headless, holds the home view, answers
# applications' open/save/load and Files' handoffs. The dialog is the
# `chooser` unit, which the broker starts through init on the first Open.
# Applications receive the selected document, never directory access.
{
  image:     filepicker
  budget:    { user: 16mb }
  grant:     [log]
  essential: false
  give: [
    { tag: init, self: true }
    { tag: view, fs: "", ro: false }
  ]
}
