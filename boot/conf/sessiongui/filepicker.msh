# Per-session Open/Save broker. Only its user-mediated dialog owns the home
# view; applications receive the selected document, never directory access.
{
  image:     filepicker
  budget:    { user: 24mb }
  grant:     [log]
  essential: false
  give: [
    { tag: clip, unit: clipsvc }
    { tag: display, session: true }
    { tag: font, session: true }
    { tag: view, fs: "", ro: false }
  ]
}
