# dotd's settings: the upstream DNS-over-TLS resolver to forward to, and
# the name its certificate must carry. In the drill this is the runner's
# DoT responder, reached through slirp at 10.0.2.100:853, presenting the
# certificate for tls.moss.test.
{ upstream: 10.0.2.100, port: 853, name: tls.moss.test }
