# The system font settings — the layer fontsvc reads for its defaults.
# A user overrides these in home/<user>/conf/font.msh (merged by
# lib/settings, unless a key is locked); the whole system's text follows
# the result, so one `scale` change resizes every program's type at once
# (the accessibility knob). Sizes are logical pixels, before scaling.
#
# `*_family` names a font by its family name; fontsvc registers every
# .ttf under the assets/fonts tier, so installing a font (drop the file
# there) and naming it here is all it takes. Bundled: "IBM Plex Sans"
# and "IBM Plex Mono"; "IBM Plex Serif" ships in assets/available as an
# example a user can install.
#
# The appearance axes a GUI resolves its colour palette from — the theme
# and the accessibility switches. Every key here must be present for a
# user's override to take (lib/settings.merge keeps the system layer's
# keys), so the defaults live here and a user layer overrides them:
#   theme     dark | light
#   contrast  normal | high        (high-contrast accessibility)
#   colors    default | cb-safe    (colourblind-safe, Okabe-Ito hues)
{
  scale:        1.0
  ui:           16
  title:        22
  mono:         15
  ui_family:    "IBM Plex Sans"
  title_family: "IBM Plex Sans"
  mono_family:  "IBM Plex Mono"
  theme:        dark
  contrast:     normal
  colors:       default
  # Keys a user's layer may NOT override — an administrator's enforced
  # appearance. `theme` is locked here (the organisation mandates the dark
  # theme): a user's font.msh can change scale, contrast and colours, but a
  # `theme` it sets is ignored and the system value above (dark) stands.
  # fontsvc reads this list and lib/settings honours it in every per-user
  # merge, so the lock holds for every program's type and palette at once.
  locked: ["theme"]
}
